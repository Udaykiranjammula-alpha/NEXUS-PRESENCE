# ============================================================
# NEXUS-PRESENCE CONFIGURATION TEMPLATE
# Project: Multi-Node Ambient Wi-Fi Human Presence System
# Author: Uday Kiran Jammula
# ============================================================

# Project Identity
PROJECT_NAME=NEXUS-PRESENCE
AUTHOR=Uday Kiran Jammula

# Wi-Fi Network Configuration (ESP32 Master AP)
WIFI_SSID=NEXUS_PRESENCE
WIFI_PASSWORD=nexus123
MASTER_IP=192.168.4.1

# Telemetry Server & Networking
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UDP_PORT=5005
WS_PORT=8000

# Node IDs
NODE_1_ID=1
NODE_2_ID=2
NODE_3_ID=3
NODE_4_ID=4

# Sensing & CSI Mode
# Options: AUTO, RSSI_ONLY, CSI_RSSI
SENSING_MODE=AUTO

# Signal Processing Hyperparameters
WINDOW_SIZE=10
BASELINE_CALIBRATION_SECONDS=10
STABLE_THRESHOLD=2.0
LOW_ACTIVITY_THRESHOLD=4.0
MOVEMENT_THRESHOLD=7.0

# 3D Virtual Room Dimensions (Meters)
ROOM_WIDTH=10.0
ROOM_LENGTH=10.0
ROOM_HEIGHT=3.0

# 3D Sensor Node Anchor Coordinates (X, Y, Z in meters)
NODE_1_POS=0.0,0.0,2.0
NODE_2_POS=10.0,0.0,2.0
NODE_3_POS=0.0,10.0,2.0
NODE_4_POS=10.0,10.0,2.0

# Demo Simulation Configuration
SIMULATION_SPEED=1.0
SIMULATION_NOISE_LEVEL=0.05
